---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile, hasNotes } from '../lib';

const { title, description = profile.tagline } = Astro.props;
const path = Astro.url.pathname;

// Add a nav entry here when a new section goes live.
const nav = [
  { href: '/projects/', text: 'Projects' },
  { href: '/#numbers', text: 'Numbers' },
  ...(hasNotes ? [{ href: '/notes/', text: 'Notes' }] : []),
  { href: '/resume/', text: 'Resume' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a10" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title ? `${title} · ${profile.name}` : profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? `${title} · ${profile.name}` : profile.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title ? `${title} · ${profile.name}` : profile.name}</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="home" href="/"><span>~/</span>keshav</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={!n.href.includes('#') && path.startsWith(n.href) ? 'page' : undefined}>{n.text}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <div>
          <p class="foot-name">{profile.name}</p>
          <p class="muted">{profile.location} · open to new-grad roles</p>
        </div>
        <nav class="foot-links" aria-label="Elsewhere">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.links.github}>GitHub</a>
          <a href={profile.links.linkedin}>LinkedIn</a>
          <a href="/resume/">Resume</a>
        </nav>
        <p class="foot-note muted">Built with Astro from one content folder · <a href="https://github.com/happyc0der/happyc0der.github.io">source</a> (code public domain, content © {new Date().getFullYear()} {profile.name})</p>
      </div>
    </footer>
  </body>
</html>
