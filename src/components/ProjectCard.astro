---
import { tagNames } from '../lib';
const { project, thumb = false, eager = false } = Astro.props;
const d = project.data;
---
<a class:list={['card', { 'has-thumb': thumb }]} href={`/projects/${project.id}/`} data-tags={d.tags.join(' ')}>
  {thumb && (
    d.image
      ? <div class="thumb"><img src={d.image} alt="" loading={eager ? "eager" : "lazy"} decoding="async" /></div>
      : <div class="thumb text"><span>{d.stats[0] ?? d.title}</span></div>
  )}
  <div class="top">
    <h3>{d.title}</h3>
    <span class="mono muted">{d.status ? d.status : d.year}</span>
  </div>
  <p>{d.blurb}</p>
  <div class="tags">{d.tags.map((t: string) => <span class="tag">{tagNames[t]}</span>)}</div>
  {d.stats.length > 0 && <div class="stats mono">{d.stats.map((s: string) => <span>{s}</span>)}</div>}
</a>
