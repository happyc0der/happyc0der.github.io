---
import Picture from './Picture.astro';
import { tagNames, badge } from '../lib';
const { project, thumb = false, eager = false } = Astro.props;
const d = project.data;
const b = badge(d);
// Cards show the 16:9 top slice from scripts/make-images.mjs; the full image stays on the project page.
// Three columns of about 20rem on desktop, two on tablets, one on phones.
const sizes = '(min-width: 64rem) 21rem, (min-width: 40rem) 46vw, 100vw';
---
<a class:list={['card', { 'has-thumb': thumb }]} href={`/projects/${project.id}/`} data-tags={d.tags.join(' ')}>
  {thumb && (
    d.image
      ? <div class="thumb" style={`view-transition-name: shot-${project.id}`}><Picture src={d.image} thumb sizes={sizes} eager={eager} /></div>
      : <div class="thumb text"><span>{d.stats[0] ?? d.title}</span></div>
  )}
  <div class="top">
    <h3>{d.title}</h3>
    <span class:list={['mono', b.live ? 'pill' : 'muted']}>{b.text}</span>
  </div>
  <p>{d.blurb}</p>
  <div class="tags">{d.tags.map((t: string) => <span class="tag">{tagNames[t]}</span>)}</div>
  {d.stats.length > 0 && <div class="stats mono">{d.stats.map((s: string) => <span>{s}</span>)}</div>}
</a>
