---
// One group of the About skills: up to eight chips, each chip's bracketed detail in its tooltip (and read out to
// screen readers), and the rest of the list behind a "+N more" that opens in place.
import type { Chip } from '../../lib';
const { group, name, reveal = false } = Astro.props as { group: { shown: Chip[]; more: Chip[] }; name: string; reveal?: boolean };
---
<div class="skill-group" data-reveal={reveal ? '' : undefined}>
  <h3 class="label quiet">{name}</h3>
  <ul class="tags skill-list">{group.shown.map((c) => <li class="tag" title={c.detail || undefined}>{c.name}{c.detail && <span class="sr-only"> ({c.detail})</span>}</li>)}</ul>
  {group.more.length > 0 && (
    <details class="skill-rest">
      <summary class="mono">+{group.more.length} more</summary>
      <ul class="tags skill-list">{group.more.map((c) => <li class="tag" title={c.detail || undefined}>{c.name}{c.detail && <span class="sr-only"> ({c.detail})</span>}</li>)}</ul>
    </details>
  )}
</div>
