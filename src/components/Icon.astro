---
// Small stroke icons drawn in currentColor, so a button's text colour is its icon colour.
// Inline SVG rather than glyphs: the latin font subsets do not carry arrows.
const { name, class: cls } = Astro.props;
const paths: Record<string, string> = {
  right: 'M4 12h15M13 6l6 6-6 6',
  left: 'M20 12H5M11 6l-6 6 6 6',
  up: 'M12 20V5M6 11l6-6 6 6',
  down: 'M12 4v15M6 13l6 6 6-6',
  out: 'M7 17L17 7M8 7h9v9',
  plus: 'M12 5v14M5 12h14',
  expand: 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5',
  play: 'M8 5.5v13l10.5-6.5z',
};
---
{name === 'star'
  ? <svg class:list={['icon', 'icon-star', cls]} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5c.6 5.6 4.9 9.9 10.5 10.5-5.6.6-9.9 4.9-10.5 10.5C11.4 16.9 7.1 12.6 1.5 12 7.1 11.4 11.4 7.1 12 1.5z" fill="currentColor" /></svg>
  : <svg class:list={['icon', cls]} viewBox="0 0 24 24" aria-hidden="true" fill={name === 'play' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={paths[name]} /></svg>}
