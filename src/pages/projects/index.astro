---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { tagNames } from '../../lib';

const projects = (await getCollection('projects')).filter((p) => p.data.listed).sort((a, b) => a.data.order - b.data.order);
const count = (tag: string) => projects.filter((p) => p.data.tags.includes(tag)).length;
---
<Base title="Projects" description={`${projects.length} projects: systems, cryptography, machine learning, data and quant work, with code and measured results.`}>
  <div class="wrap page-top">
    <p class="label">Index · {projects.length} projects</p>
    <h1 class="page-title" data-split="chars" data-intro>Projects</h1>
    <p class="lead" data-reveal-intro>{projects.length} things I have built or taken apart. Each page says what I did, what it measured, and what did not work.</p>
    <div class="plist-bar" data-reveal-intro>
      <div class="chips" role="toolbar" aria-label="Filter by area">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">all <span>{projects.length}</span></button>
        {Object.entries(tagNames).map(([tag, name]) => <button class="chip" type="button" data-filter={tag} aria-pressed="false">{name} <span>{count(tag)}</span></button>)}
      </div>
      <p class="mono muted plist-shown" aria-live="polite"><span data-shown>{projects.length}</span> shown</p>
    </div>
    <ol class="plist">{projects.map((p, i) => <ProjectRow project={p} index={i} />)}</ol>
  </div>
</Base>

<script>
  // Area filters. Without JS the chips are hidden and every project is listed.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-tags]');
  const shown = document.querySelector<HTMLElement>('[data-shown]');
  const apply = (filter: string) => {
    if (filter !== 'all' && ![...chips].some((c) => c.dataset.filter === filter)) filter = 'all';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    let n = 0;
    items.forEach((el) => {
      el.hidden = filter !== 'all' && !el.dataset.tags!.split(' ').includes(filter);
      if (!el.hidden) n++;
    });
    if (shown) shown.textContent = String(n);
    dispatchEvent(new Event('kr:layout'));
  };
  chips.forEach((c) => c.addEventListener('click', () => {
    history.replaceState(null, '', c.dataset.filter === 'all' ? location.pathname : `#${c.dataset.filter}`);
    apply(c.dataset.filter!);
  }));
  const fromHash = () => apply(location.hash.slice(1) || 'all');
  addEventListener('hashchange', fromHash);
  fromHash();
</script>
