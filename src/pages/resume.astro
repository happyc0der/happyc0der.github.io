---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { resumes, hue, pad } from '../lib';

// The build date written inside the PDF (CreationDate). File mtimes are useless here: in CI they are the
// checkout time, so every daily stats deploy would label the resumes as updated today.
const updated = (file: string) => {
  try {
    const m = fs.readFileSync(`./public/resume/${file}.pdf`, 'latin1').match(/CreationDate\s*\(D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})([Z+-])?(\d{2})?'?(\d{2})?/);
    if (!m) return null;
    const [, y, mo, d, h, mi, s, sign, oh, om] = m;
    const zone = !sign || sign === 'Z' ? 'Z' : `${sign}${oh ?? '00'}:${om ?? '00'}`;
    return new Date(`${y}-${mo}-${d}T${h}:${mi}:${s}${zone}`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
  } catch { return null; }
};
const list = Object.values(resumes) as any[];
---
<Base title="Resume" description="One-page resumes for software, ML, data, security and quant roles.">
  <div class="wrap page-top">
    <p class="label">{list.length} one-page PDFs</p>
    <h1 class="page-title" data-split="chars" data-intro>Resume</h1>
    <p class="lead" data-reveal-intro>One page each, built from the same project data as this site. Pick the one that fits the role.</p>
    <ul class="resumes">
      {list.map((r, i) => (
        <li class="rcard" data-reveal style={`--hue: ${hue(i)}`}>
          <a class="rcard-preview" href={`/resume/${r.file}.pdf`} data-cursor="PDF" aria-label={`Open the ${r.label} resume (PDF)`}>
            <img src={`/resume/${r.file}.png`} alt="" loading="lazy" decoding="async" width="612" height="792" />
          </a>
          <div class="rcard-body">
            <p class="rcard-num mono" aria-hidden="true">{pad(i + 1)} / {pad(list.length)}</p>
            <h2>{r.label}</h2>
            <p class="muted">{r.headline}</p>
            <div class="links">
              <a class="btn primary" href={`/resume/${r.file}.pdf`} data-cursor="PDF">Open PDF <Icon name="out" /></a>
              <a class="btn" href={`/resume/${r.file}.pdf`} download>Download <Icon name="down" /></a>
            </div>
            {updated(r.file) && <p class="mono muted rcard-date">Updated {updated(r.file)}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
