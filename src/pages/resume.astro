---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import { resumes } from '../lib';

// The build date written inside the PDF (CreationDate). File mtimes are useless here: in CI they are the
// checkout time, so every daily stats deploy would label the resumes as updated today.
const updated = (file: string) => {
  try {
    const m = fs.readFileSync(`./public/resume/${file}.pdf`, 'latin1').match(/CreationDate\s*\(D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})([Z+-])?(\d{2})?'?(\d{2})?/);
    if (!m) return null;
    const [, y, mo, d, h, mi, s, sign, oh, om] = m;
    const zone = !sign || sign === 'Z' ? 'Z' : `${sign}${oh ?? '00'}:${om ?? '00'}`;
    return new Date(`${y}-${mo}-${d}T${h}:${mi}:${s}${zone}`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
  } catch { return null; }
};
---
<Base title="Resume" description="One-page resumes for software, ML, data, security and quant roles.">
  <h1 class="page-title">Resume</h1>
  <p class="muted lead">One page each, built from the same project data as this site. Pick the one that fits the role.</p>
  <div class="resumes">
    {Object.values(resumes).map((r: any) => (
      <article class="resume-card">
        <a class="preview" href={`/resume/${r.file}.pdf`} aria-label={`Open the ${r.label} resume (PDF)`}>
          <img src={`/resume/${r.file}.png`} alt="" loading="lazy" decoding="async" width="612" height="792" />
        </a>
        <div class="body">
          <h2>{r.label}</h2>
          <p class="muted">{r.headline}</p>
          <div class="links">
            <a class="btn primary" href={`/resume/${r.file}.pdf`}>Open PDF</a>
            <a class="btn" href={`/resume/${r.file}.pdf`} download>Download</a>
          </div>
          {updated(r.file) && <p class="mono muted small">Updated {updated(r.file)}</p>}
        </div>
      </article>
    ))}
  </div>
</Base>
