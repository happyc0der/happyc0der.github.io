---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import { profile, competitions, hue, pad, resultShort, sentences, skillChips } from '../lib';
import { commitStats, publicStats, hasStats } from '../stats';

const projects = (await getCollection('projects')).filter((p) => p.data.listed).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const demos = projects.filter((p) => p.data.demo_embed);
const listedIds = new Set(projects.map((p) => p.id));

// Sections number themselves, so one that has nothing to show (Live demos until the first demo lands)
// leaves no gap in the count.
const order = ['about', 'work', demos.length && 'demos', competitions.length && 'competitions', hasStats() && 'numbers', 'education', 'contact'].filter(Boolean) as string[];
const num = (id: string) => ({ n: order.indexOf(id) + 1, total: order.length });

// About: four or five figures, each read from content/ at build time. A missing source drops its figure.
const commits = commitStats();
const lc = publicStats().leetcode;
const finals = competitions.map((c: any) => c.result.match(/Final rank [\d,]+ of [\d,]+ teams \(top (\d+)%\)/)).filter(Boolean).map((m: any) => +m[1]);
const counters = [
  { value: projects.length, label: 'projects written up on this site' },
  commits && { value: commits.total.toLocaleString('en-US'), label: 'commits in the last year, private repos included' },
  commits && { value: commits.repos, label: 'repositories those commits went to' },
  finals.length && { pre: 'top ', value: Math.min(...finals), unit: '%', label: 'best final Kaggle finish' },
  lc?.solved && { value: lc.solved.toLocaleString('en-US'), label: 'LeetCode problems solved' },
].filter(Boolean) as { pre?: string; value: string | number; unit?: string; label: string }[];

// About: the lead (first and last sentence) fills in with the scroll; the examples between them sit under it.
const lead: string | undefined = profile.about_lead;
const examples = lead ? sentences(profile.about).filter((x) => !lead.includes(x)) : [];

// Skills, display only (the resumes read the same lists): up to eight chips a group, a name once across groups,
// the first five groups in profile.yaml order on show and the others, plus every group's extra chips, under "More".
const skillNames: Record<string, string> = { languages: 'Languages', systems: 'Systems', ml: 'Machine learning', ai: 'AI and agents', data: 'Data', security: 'Security', testing: 'Testing', quant: 'Quant', tools: 'Tools' };
const SHOWN = 5;
const chipGroups = skillChips(profile.skills, Object.keys(profile.skills));
const skillsShown = chipGroups.slice(0, SHOWN), skillsMore = chipGroups.slice(SHOWN);
const skillsExtra = chipGroups.flatMap((g) => g.more);

// Every course on the transcripts, once. profile.yaml groups them by resume track, not by school.
const courses = [...new Set(Object.values(profile.coursework as Record<string, string[]>).flat())];
---
<Base>
  <Hero />
  <Marquee />

  <section class="section about" id="about">
    <div class="wrap">
      <SectionHead {...num('about')} title="About" />
      {lead ? (
        <div class="about-text">
          <p class="statement" data-scrub>{lead}</p>
          {examples.length > 0 && <p class="about-examples" data-reveal>{examples.join(' ')}</p>}
        </div>
      ) : profile.about && <p class="statement" data-scrub>{profile.about}</p>}
      <dl class="counters">
        {counters.map((c) => (
          <div class="counter" data-reveal>
            <dt>{c.label}</dt>
            <dd>{c.pre && <small class="pre">{c.pre}</small>}<span data-count>{c.value}</span>{c.unit && <small>{c.unit}</small>}</dd>
          </div>
        ))}
      </dl>
      <div class="skills">
        {skillsShown.map((g) => (
          <div class="skill-group" data-reveal>
            <h3 class="label quiet">{skillNames[g.key] ?? g.key}</h3>
            <ul class="tags skill-list">{g.shown.map((c) => <li class="tag" title={c.detail || undefined}>{c.name}{c.detail && <span class="sr-only"> ({c.detail})</span>}</li>)}</ul>
          </div>
        ))}
      </div>
      {(skillsMore.length > 0 || skillsExtra.length > 0) && (
        <details class="skills-more" data-reveal>
          <summary><span class="label quiet">More</span><span class="skills-more-names">{[...skillsMore.map((g) => skillNames[g.key] ?? g.key), skillsExtra.length > 0 && 'and the rest of each list'].filter(Boolean).join(', ')}</span><span class="acc-icon" aria-hidden="true"><Icon name="plus" /></span></summary>
          <div class="skills">
            {skillsMore.map((g) => (
              <div class="skill-group">
                <h3 class="label quiet">{skillNames[g.key] ?? g.key}</h3>
                <ul class="tags skill-list">{g.shown.map((c) => <li class="tag" title={c.detail || undefined}>{c.name}{c.detail && <span class="sr-only"> ({c.detail})</span>}</li>)}</ul>
              </div>
            ))}
            {skillsExtra.length > 0 && (
              <div class="skill-group skill-group-wide">
                <h3 class="label quiet">Also</h3>
                <ul class="tags skill-list">{skillsExtra.map((c) => <li class="tag" title={c.detail || undefined}>{c.name}{c.detail && <span class="sr-only"> ({c.detail})</span>}</li>)}</ul>
              </div>
            )}
          </div>
        </details>
      )}
    </div>
  </section>

  <section class="section work" id="work" data-work>
    <div class="wrap">
      <SectionHead {...num('work')} title="Selected work">
        <p class="work-count mono" aria-hidden="true"><span data-work-index>01</span> / {pad(featured.length)}</p>
      </SectionHead>
    </div>
    <div class="work-viewport" data-work-viewport>
      <ol class="work-track" data-work-track>
        {featured.map((p) => <li><ProjectCard project={p} index={projects.indexOf(p)} /></li>)}
        <li class="work-more"><a href="/projects/" data-cursor="Open" data-label="Projects"><span class="mono">Index</span><strong>All {projects.length} projects</strong><Icon name="right" /></a></li>
      </ol>
    </div>
  </section>

  {demos.length > 0 && (
    <section class="section demos" id="demos">
      <div class="wrap">
        <SectionHead {...num('demos')} title="Live demos" />
        <p class="section-lead">These run in your browser, on this site. Each one says exactly what it is.</p>
        <ol class="plist dlist">
          {demos.map((p, i) => {
            const poster = p.data.demo_poster?.replace(/^\/img\/(.+)\.[^.]+$/, '$1');
            return (
              <li class="prow-item" data-reveal>
                <a class="prow drow" href={`/projects/${p.id}/#demo`} data-cursor="Demo" data-label={p.data.title} style={`--hue: ${hue(projects.indexOf(p))}`}
                  data-thumb={poster ? `/img/thumb/${poster}-800.webp` : undefined} data-thumb-text={poster ? undefined : p.data.stats[0] ?? p.data.title}>
                  <span class="prow-num mono">{pad(i + 1)}</span>
                  <div class="prow-main">
                    <h3 class="prow-title">{p.data.title}</h3>
                    {p.data.demo_kind && <p class="drow-kind mono">{p.data.demo_kind}</p>}
                  </div>
                  <span class="drow-run" aria-hidden="true"><Icon name="play" /><span>Run</span></span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  {competitions.length > 0 && (
    <section class="section comps" id="competitions">
      <div class="wrap">
        <SectionHead {...num('competitions')} title="Competitions" />
        <div class="acc">
          {competitions.map((c: any, i: number) => (
            <details class="acc-row" data-reveal>
              <summary>
                <span class="acc-num mono">{pad(i + 1)}</span>
                <span class="acc-name">{c.name}</span>
                <span class="acc-result">{resultShort(c.result)}</span>
                <span class="acc-year mono">{c.year}</span>
                <span class="acc-icon" aria-hidden="true"><Icon name="plus" /></span>
              </summary>
              <div class="acc-body">
                <p>{c.result}</p>
                {c.project && listedIds.has(c.project) && <a class="link-cta" href={`/projects/${c.project}/`}>The project <Icon name="right" /></a>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <Stats {...num('numbers')} />

  <section class="section edu" id="education">
    <div class="wrap">
      <SectionHead {...num('education')} title="Education" />
      <ul class="edu-rows">
        {profile.education.map((e: any) => (
          <li class="edu-row" data-reveal>
            <h3 class="edu-school">{e.school}</h3>
            <p class="edu-degree">{e.degree}</p>
            <p class="edu-meta mono"><span>{e.when}</span><span>{e.score}</span></p>
          </li>
        ))}
      </ul>
      {courses.length > 0 && <p class="edu-courses" data-reveal><span class="label quiet">Coursework, both degrees</span>{courses.join(' · ')}</p>}
      <a class="btn-big" href="/resume/" data-magnetic data-cursor="PDF" data-label="Resume">Resumes <Icon name="right" /></a>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap">
      <p class="shead-num mono">[ {pad(num('contact').n)} / {pad(num('contact').total)} ] · Contact</p>
      <h2 class="signoff"><span data-split>Got a hard problem?</span> <em data-split>Let's talk.</em></h2>
      <a class="contact-email" href={`mailto:${profile.email}`} data-copy={profile.email} data-cursor="Copy">{profile.email}</a>
      <p class="copy-note mono" data-copy-note aria-live="polite"></p>
      <ul class="socials">
        <li><a class="social" href={profile.links.github}>GitHub <Icon name="out" /></a></li>
        <li><a class="social" href={profile.links.linkedin}>LinkedIn <Icon name="out" /></a></li>
        <li><a class="social" href={`mailto:${profile.email}`}>Email <Icon name="out" /></a></li>
        <li><a class="social" href={profile.links.source}>Site source <Icon name="out" /></a></li>
      </ul>
    </div>
  </section>
</Base>
