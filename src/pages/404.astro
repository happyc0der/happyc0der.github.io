---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="notfound">
    <p class="label">404</p>
    <h1 class="page-title">Nothing at this address.</h1>
    <p class="muted lead">The page may have moved when the site was reorganized. These are the places most people are looking for:</p>
    <div class="links">
      <a class="btn primary" href="/">Home</a>
      <a class="btn" href="/projects/">Projects</a>
      <a class="btn" href="/resume/">Resume</a>
      <a class="btn" href="/#numbers">By the numbers</a>
    </div>
  </section>
</Base>
