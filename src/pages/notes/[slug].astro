---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { hasNotes } from '../../lib';

export async function getStaticPaths() {
  return (hasNotes ? await getCollection('notes') : []).map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
---
<Base title={note.data.title} description={note.data.summary}>
  <a class="back" href="/notes/">← Notes</a>
  <p class="label">{note.data.date.toISOString().slice(0, 10)}</p>
  <h1 class="page-title">{note.data.title}</h1>
  <div class="prose" style="margin-top:2rem"><Content /></div>
</Base>
