---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { hasNotes } from '../../lib';

// Shows up in the nav once content/notes/ has its first post.
const notes = (hasNotes ? await getCollection('notes') : []).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Notes">
  <h1 class="page-title">Notes</h1>
  <div class="rows" style="margin-top:2rem">
    {notes.length === 0 && <p class="muted" style="padding-top:1rem">Nothing here yet.</p>}
    {notes.map((n) => (
      <a class="row" href={`/notes/${n.id}/`}>
        <span class="what">{n.data.title}</span>
        <span class="when mono">{n.data.date.toISOString().slice(0, 10)}</span>
        {n.data.summary && <span class="detail">{n.data.summary}</span>}
      </a>
    ))}
  </div>
</Base>
